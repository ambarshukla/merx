# Copy to deploy/.env on the host (gitignored) and fill in.

# Free key from https://www.eia.gov/opendata/ (the API channels need it).
EIA_API_KEY=your-eia-api-key

# The Docker network the host's reverse proxy is attached to.
PROXY_NETWORK=proxy

# Where the data lives on the host (raw zone, DuckDB, Dagster history).
MERX_HOST_DATA=/opt/merx/data

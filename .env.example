# Copy to .env (which is gitignored) and fill in. Never commit real values.

# Optional. Free key from https://www.eia.gov/opendata/ . The keyless bulk
# downloads are enough for the early phases; the key unlocks the API.
EIA_API_KEY=your-eia-api-key

# Optional, later phases only. Leave unset to run with the deterministic baselines.
# LLM_PROVIDER_API_KEY=
